{
  "name": "clipkit",
  "version": "2.1.4",
  "description": "ClipKit — macOS clipboard manager (Electron)",
  "main": "main.js",
  "author": "ClipKit",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.clipkit.app",
    "productName": "ClipKit",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "icon": "assets/icon.icns",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
